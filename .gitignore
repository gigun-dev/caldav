.dev.vars*

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# cloudflared named tunnel の実設定と認証情報(config.example.yml だけコミットする)。
# tunnel 認証情報 JSON をコミットするとトンネルを乗っ取られるため必ず除外。
cloudflared/config.yml
cloudflared/*.json

# misc
.DS_Store

# claude local settings(個人環境の設定。プロジェクト共有の設定は .claude/settings.json に置く)
.claude/settings.local.json

# MCP Apps カード JS の自動生成物(2026-07-17 非コミット化)。entry(*-entry.ts)から
# wrangler build hook / CI の生成ステップが毎ビルドで再生成する。詳細は scripts/build-ui-bundle.ts。
src/presentation/mcp/ui/*-bundle.ts

# 本番 secrets の控え(wrangler secret bulk 用・絶対にコミットしない)
.secrets.prod.json
# ローカル検証用 secrets(geocoding ベンチ等・絶対にコミットしない)
.secrets.local.json
