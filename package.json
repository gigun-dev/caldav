{
  "name": "caldav",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply caldav-production --remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "bun test test/domain test/application test/infrastructure test/presentation test/integration",
    "test:worker": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p test/worker",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "build:ui": "bun run scripts/build-ui-bundle.ts",
    "boundaries": "depcruise src",
    "proxy:dev": "bun run proxy/server.ts",
    "smoke": "bun run scripts/smoke-test.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@hono/mcp": "^0.3.1",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.27",
    "ical.js": "^2.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.0.0",
    "tsdav": "^2.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.4.0"
  }
}
