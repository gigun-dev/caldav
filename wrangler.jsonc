{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caldav",
  "main": "src/index.ts",
  // MCP Apps カード JS の自動生成物(*-bundle.ts)を、worker を esbuild でバンドルする前に
  // 毎回生成する(2026-07-17 非コミット化)。src/presentation/mcp/ui/*-app.ts が *-bundle.ts を
  // 静的 import するため、この command が dev/deploy(Cloudflare Workers Builds 含む)の前段で
  // 走ることで「entry から常に最新の bundle が埋まる」ことを保証する。生成物は .gitignore 対象
  // (再生成し忘れによる staleness を構造的に排除・詳細 scripts/build-ui-bundle.ts)。
  "build": { "command": "bun run build:ui" },
  "account_id": "4b00d8d779cdc4e8fbc1840248d21722",
  "compatibility_date": "2026-07-10",
  // 【secret binding(vars ではない)】CALDAV_PASSWORD / PROXY_SHARED_SECRET / MCP_TOKEN /
  // CONFIRM_SECRET は Wrangler secret として設定する(値は wrangler.jsonc にコミットしない)。
  //   - 本番: `.secrets.prod.json`(gitignore 済みの控え)→ `wrangler secret bulk .secrets.prod.json`。
  //     単発なら `wrangler secret put <NAME>`。CONFIRM_SECRET は S1 確認カードの署名鍵(docs/modeling/14)。
  //   - dev/テスト: .dev.vars に置く(gitignore 対象)。型宣言は src/env.d.ts の CloudflareBindings。
  // 【secrets.required(2026-07-23 導入)】deploy 時に未設定 secret があるとビルドが失敗し、旧バージョンが
  // 動き続ける(設定漏れで本番の該当機能だけ静かに壊れる事故を構造的に防ぐ。CONFIRM_SECRET 未設定だと
  // delete 系が安全側全拒否になる、を deploy 失敗として顕在化させる)。wrangler types の型生成もここが正。
  "secrets": {
    "required": ["CALDAV_PASSWORD", "PROXY_SHARED_SECRET", "MCP_TOKEN", "CONFIRM_SECRET"]
  },
  "vars": {
    // 公開してよいログイン名。パスワードとプロキシ共有鍵は Wrangler secret に置く。
    "CALDAV_USERNAME": "admin",
    // iOS 実機検証用の DAV リクエストダンプのゲート。"1" で有効(src/index.ts の [DUMP] ミドルウェア)。
    // 命名は Xandikos の --dump-dav-xml / DUMP_DAV_XML に倣う(2026-07-11、旧名 CAPTURE_LOG)。
    // 一時的な検証用途。検証完了後は "0" にして無効化する(コードは残す — 再検証で使う)。
    "DUMP_DAV_REQUESTS": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caldav-production",
      "database_id": "9b116506-d4dd-4753-b835-5f7dd37d18cf",
      "migrations_dir": "migrations"
    }
  ],
  // 観測基盤 v1(2026-07-23): MCP ツール呼び出しの計測イベント(TelemetryEvent)を書く
  // Workers Analytics Engine データセット。binding 名 "TELEMETRY" は presentation/mcp/server.ts
  // の McpAppDeps.telemetry(TelemetryPort)を組み立てる app.ts が読む(infrastructure/telemetry/
  // analytics-engine-telemetry.ts が実装)。dataset 名は "caldav_mcp_events"(AE 側でクエリする
  // FROM 句に使う識別子。プロジェクト名の慣習に合わせ "caldav_" プレフィックス + 何のイベントか)。
  // AE は D1 と違い migrations 相当の仕組みが無く、dataset は初回 writeDataPoint 時に暗黙作成
  // される(Cloudflare 側の仕様)ので、ここでの追加だけでよく別途プロビジョニング操作は不要。
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "caldav_mcp_events"
    }
  ],
  "kv_namespaces": [
    {
      // "OAUTH_KV" は @cloudflare/workers-oauth-provider がライブラリ内部でハードコードして
      // env.OAUTH_KV を読む binding 名(利用側で名前を変えられない)。ここでリネームすると
      // provider が KV を見つけられず認可コード/トークンの永続化が全滅するので固定必須。
      // 2026-07-12 OAuth-for-MCP 第1スライス: 土台のみ追加(まだ OAuthProvider は new していない=無挙動変更)。
      "binding": "OAUTH_KV",
      "id": "0c627402f5fb4235a096885e1fba2a35"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 2026-07-14 レイテンシ対策: Smart Placement。本 Worker は D1 を直列に複数回叩く
  // (todo mutate 1回で read→PUT batch→一覧再構築)。既定ではユーザー最寄りエッジで実行される
  // ため、D1 のホームリージョンと離れていると往復ごとに大陸間 RTT を払う(実測: CPU p95=34ms
  // なのに wall が秒単位 — I/O 待ち支配の決定的証拠)。smart は実トラフィックの
  // サブリクエスト先(D1)を見て実行ロケーションを D1 側へ寄せ、往復を域内 RTT にする。
  // 注意: 効果はトラフィックの学習後に出る(即時ではない)。効果測定は {mcpTool, ms} ログで。
  "placement": { "mode": "smart" }
}
