{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caldav",
  "main": "src/index.ts",
  "account_id": "4b00d8d779cdc4e8fbc1840248d21722",
  "compatibility_date": "2026-07-10",
  "vars": {
    // 公開してよいログイン名。パスワードとプロキシ共有鍵は Wrangler secret に置く。
    "CALDAV_USERNAME": "admin",
    // iOS 実機検証用の DAV リクエストダンプのゲート。"1" で有効(src/index.ts の [DUMP] ミドルウェア)。
    // 命名は Xandikos の --dump-dav-xml / DUMP_DAV_XML に倣う(2026-07-11、旧名 CAPTURE_LOG)。
    // 一時的な検証用途。検証完了後は "0" にして無効化する(コードは残す — 再検証で使う)。
    "DUMP_DAV_REQUESTS": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caldav-production",
      "database_id": "9b116506-d4dd-4753-b835-5f7dd37d18cf",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // "OAUTH_KV" は @cloudflare/workers-oauth-provider がライブラリ内部でハードコードして
      // env.OAUTH_KV を読む binding 名(利用側で名前を変えられない)。ここでリネームすると
      // provider が KV を見つけられず認可コード/トークンの永続化が全滅するので固定必須。
      // 2026-07-12 OAuth-for-MCP 第1スライス: 土台のみ追加(まだ OAuthProvider は new していない=無挙動変更)。
      "binding": "OAUTH_KV",
      "id": "0c627402f5fb4235a096885e1fba2a35"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 2026-07-14 レイテンシ対策: Smart Placement。本 Worker は D1 を直列に複数回叩く
  // (todo mutate 1回で read→PUT batch→一覧再構築)。既定ではユーザー最寄りエッジで実行される
  // ため、D1 のホームリージョンと離れていると往復ごとに大陸間 RTT を払う(実測: CPU p95=34ms
  // なのに wall が秒単位 — I/O 待ち支配の決定的証拠)。smart は実トラフィックの
  // サブリクエスト先(D1)を見て実行ロケーションを D1 側へ寄せ、往復を域内 RTT にする。
  // 注意: 効果はトラフィックの学習後に出る(即時ではない)。効果測定は {mcpTool, ms} ログで。
  "placement": { "mode": "smart" }
}
